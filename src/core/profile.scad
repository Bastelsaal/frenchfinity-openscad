//
// Frenchfinity core: slot profile, tongues and slots
//
// Coordinate system used by every part of this generator:
//
//   x: along the slot, from the left edge of a part (x = 0) to its right edge.
//   y: y = 0 is the mounting plane: the front face of wall anchors and plates and the back face of
//      holders. Holders extend to +y (into the room), anchors and plates extend to -y (to the wall).
//   z: up, as the part hangs on the wall. The top edge of a part is passed as `top`.
//
// A holder carries a tongue that protrudes from the mounting plane to -y. Anchors and plates carry
// the matching slot, cut from the mounting plane into -y. Tongue and slot are centered
// `ff_slot_offset()` below the top edge of their part, so holders and anchors are flush at the top.
//

ff_eps = 0.01;

//
// Profile presets
//
// [neck height, neck depth, head height, head depth, distance of the slot center line to the top edge]
//
// "frenchfinity": Frenchfinity 1.0 (Fusion 360 parts) and wooden parts milled with the M5 T-slot router bit.
// "openscad_v1_legacy": parts generated by version 1 of this OpenSCAD generator (neck size swapped).
//

function ff_profile() =
    slot_profile == "openscad_v1_legacy" ? [6.5, 5.6, 8.5, 4.5, 10.644] :
    slot_profile == "custom"             ? [
                                               slot_custom_neck_height,
                                               slot_custom_neck_depth,
                                               slot_custom_head_height,
                                               slot_custom_head_depth,
                                               slot_custom_center_from_top
                                           ] :
                                           [5.6, 6.5, 8.5, 4.5, 10.194];

function ff_neck_height() = ff_profile()[0];
function ff_neck_depth()  = ff_profile()[1];
function ff_head_height() = ff_profile()[2];
function ff_head_depth()  = ff_profile()[3];

// Distance from the top edge of a part to the center line of its slot or tongue.
function ff_slot_offset() = ff_profile()[4];

// Depth of a slot, measured from the mounting plane.
function ff_slot_depth() = ff_neck_depth() + ff_head_depth();

// How far a tongue protrudes from the back face of a holder.
function ff_tongue_depth() = ff_slot_depth() - print_tolerance;

// Distance from the top edge of a part to the lowest point of its slot or tongue.
function ff_slot_bottom_offset() = ff_slot_offset() + ff_head_height() / 2;

// Distance from the top edge of a part to the highest point of its slot.
function ff_slot_top_offset() = ff_slot_offset() - ff_head_height() / 2;

// Distance from the top edge of a holder to the highest / lowest point of its tongue.
function ff_tongue_top_offset() = ff_slot_top_offset() + print_tolerance;
function ff_tongue_bottom_offset() = ff_slot_bottom_offset() - print_tolerance;

// Minimum height a part needs to carry a slot or a tongue.
function ff_min_height() = ff_slot_bottom_offset() + 2;

// z position of the slot center line of a part whose top edge is at `top`.
function ff_slot_z(top) = top - ff_slot_offset();

//
// 2D profiles in the (y, z) plane: 2D x is the world y axis, 2D y is the world z axis and the
// origin is the slot center line on the mounting plane.
//

// Cross section of a slot (the cut-out in anchors and plates). `filament` adds the filament channel.
module ff_slot_2d(filament = filament_hole) {
    neck_height = ff_neck_height();
    neck_depth  = ff_neck_depth();
    head_height = ff_head_height();
    head_depth  = ff_head_depth();

    union() {
        // The neck reaches a bit out of the mounting plane so the cut opens cleanly.
        translate([-neck_depth, -neck_height / 2])
            square([neck_depth + ff_eps, neck_height]);

        translate([-(neck_depth + head_depth), -head_height / 2])
            square([head_depth, head_height]);

        if (filament)
            translate([-(neck_depth + head_depth), 0])
                circle(d = filament_hole_diameter, $fn = 24);
    }
}

// Cross section of a tongue. The print tolerance is removed on every side, the neck reaches a bit
// into the holder body so the tongue merges cleanly with it. `filament` adds the filament groove.
module ff_tongue_2d(filament = filament_hole) {
    tolerance   = print_tolerance;
    neck_height = ff_neck_height() - 2 * tolerance;
    neck_depth  = ff_neck_depth() + tolerance;
    head_height = ff_head_height() - 2 * tolerance;
    head_depth  = ff_head_depth() - 2 * tolerance;

    difference() {
        union() {
            translate([-neck_depth, -neck_height / 2])
                square([neck_depth + ff_eps, neck_height]);

            translate([-(neck_depth + head_depth), -head_height / 2])
                square([head_depth, head_height]);
        }

        if (filament)
            translate([-(neck_depth + head_depth), 0])
                circle(d = filament_hole_diameter, $fn = 24);
    }
}

// Extrudes a (y, z) profile along the x axis from x = 0 to x = length.
module ff_extrude_along_x(length) {
    rotate([90, 0, 90])
        linear_extrude(height = length)
            children();
}

//
// 3D bodies
//

// Tongue along the top edge of a holder whose back face lies in the mounting plane. It runs from
// x = 0 to x = length, the top edge of the holder is at z = top. Both ends stay ff_eps inside the
// part: end faces that coincide with the side faces of the holder body produce non-manifold edges
// in the exported STL.
module ff_tongue(length, top) {
    translate([ff_eps, 0, ff_slot_z(top)])
        ff_extrude_along_x(length - 2 * ff_eps)
            ff_tongue_2d();
}

// Cut body of a slot along the top edge of an anchor or plate whose front face lies in the mounting
// plane. Subtract it from the part. It is slightly longer than `length` so the slot opens at both ends.
module ff_slot(length, top) {
    translate([-ff_eps, 0, ff_slot_z(top)])
        ff_extrude_along_x(length + 2 * ff_eps)
            ff_slot_2d();
}

// Tongue for a part whose back face is NOT in the mounting plane: `back_y` is the y position of
// the back face, the tongue protrudes from there to -y.
module ff_tongue_at(length, top, back_y) {
    translate([0, back_y, 0])
        ff_tongue(length, top);
}

// Slot for a part whose front face is NOT in the mounting plane: `front_y` is the y position of
// the front face, the slot is cut from there to -y.
module ff_slot_at(length, top, front_y) {
    translate([0, front_y, 0])
        ff_slot(length, top);
}
